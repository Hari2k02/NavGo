{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@zeppos/device-types"]
  },
  "include": ["app.js", "page/**/*.js", "lib/**/*.js"]
}
