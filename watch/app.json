{
  "configVersion": "v3",
  "app": {
    "appId": 1099901,
    "appName": "NavGo",
    "appType": "app",
    "version": { "code": 1, "name": "0.1.0" },
    "icon": "icon.png",
    "vender": "NavGo",
    "description": "Private local Google Maps navigation companion."
  },
  "permissions": ["device:os.ble"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0.0"
    }
  },
  "targets": {
    "trex3": {
      "module": { "page": { "pages": ["page/index"] } },
      "platforms": [{ "st": "r", "sr": "w480" }],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": { "appName": "NavGo" }
  },
  "defaultLanguage": "en-US"
}
